                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}",
                "description": "Dashboard password. Leave empty for the public demo."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/spend?status=pending&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "spend"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
