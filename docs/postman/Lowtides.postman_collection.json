    {
      "name": "4. Webhooks to Zapier",
      "item": [
        {
          "name": "List webhooks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}",
                "description": "Dashboard password. Leave empty for the public demo."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"lists hooks and event types\", () => { pm.expect(j.events).to.have.property(\"spend.needs_approval\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Add a Zapier Catch Hook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}",
                "description": "Dashboard password. Leave empty for the public demo."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks"
              ]
            },
            "description": "Set zapierHookUrl in the environment to your Zapier Catch Hook URL. See docs/ZAPIER.md.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{zapierHookUrl}}\",\n  \"label\": \"Text me approvals\",\n  \"events\": [\n    \"spend.needs_approval\",\n    \"agent.killed\",\n    \"stop_all\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"saved, with a signing secret\", () => { pm.expect(j.secret).to.match(/^whsec_/); });",
                  "pm.collectionVariables.set(\"webhookId\", j.webhook.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send a signed test event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}",
                "description": "Dashboard password. Leave empty for the public demo."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/{{webhookId}}/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "{{webhookId}}",
                "test"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Zapier received it\", () => { pm.expect(j.ok).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the webhook",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}",
                "description": "Dashboard password. Leave empty for the public demo."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/{{webhookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "{{webhookId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"deleted\", () => { pm.expect(j.ok).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
