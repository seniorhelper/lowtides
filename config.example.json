{
  "_readme": "Copy this file to config.json and edit. Prices are USD per 1 million tokens. Check every price against your provider's official pricing page before trusting the dollar figures.",
  "app_name": "CostCop",
  "mode": "home",
  "show_signature_heart": true,
  "providers": {
    "anthropic": {
      "type": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY"
    },
    "local": {
      "type": "openai",
      "base_url": "http://localhost:11434/v1",
      "api_key_env": ""
    },
    "simulator": {
      "type": "simulator"
    }
  },
  "models": {
    "claude-haiku-5-5":  {"provider": "anthropic", "tier": 1, "family": "anthropic", "input": 0.10, "output": 0.50, "cache_write": 0.125, "cache_read": 0.01, "note": "Third-party trackers report this rate for prompts up to 100K tokens. Verify."},
    "claude-sonnet-5-5": {"provider": "anthropic", "tier": 2, "family": "anthropic", "input": 2.00, "output": 10.00, "cache_write": 2.50, "cache_read": 0.20},
    "claude-opus-5-5":   {"provider": "anthropic", "tier": 3, "family": "anthropic", "input": 4.00, "output": 20.00, "cache_write": 5.00, "cache_read": 0.20},
    "sim-small":  {"provider": "simulator", "tier": 1, "family": "simulator", "input": 0.10, "output": 0.50},
    "sim-medium": {"provider": "simulator", "tier": 2, "family": "simulator", "input": 2.00, "output": 10.00},
    "sim-large":  {"provider": "simulator", "tier": 3, "family": "simulator", "input": 4.00, "output": 20.00}
  },
  "policy": {
    "routing": "cascade",
    "allow_downgrade": true,
    "verify_and_escalate": true,
    "trim_context": true,
    "trim_keep_recent_turns": 6,
    "trim_max_old_tool_chars": 1500,
    "auto_prompt_cache": true,
    "prompt_cache_min_tokens": 2048,
    "answer_memory": true,
    "answer_memory_ttl_hours": 24,
    "near_duplicate_threshold": 0.92,
    "loop_window_seconds": 120,
    "loop_max_repeats": 4,
    "max_calls_per_minute": 60,
    "default_daily_budget": 5.00,
    "default_task_budget": 1.00,
    "shadow_sample_rate": 0.0,
    "max_output_tokens_cap": 8192
  },
  "paypal": {
    "env": "sandbox",
    "client_id_env": "PAYPAL_CLIENT_ID",
    "client_secret_env": "PAYPAL_CLIENT_SECRET",
    "webhook_id_env": "PAYPAL_WEBHOOK_ID",
    "currency": "USD",
    "min_hold": 1.00,
    "public_base_url": "http://localhost:8787"
  },
  "business": {
    "default_markup_percent": 20,
    "invoice_note": "AI agent usage, governed and optimized. Savings receipt attached."
  }
}
